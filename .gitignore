# .gitignore for AI Image Analyzer

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/

# Environment variables
.env
.env.local

# IDEs
.vscode/
.idea/

# Large Model Weights
*.pt
*.pth
yolov8n.pt

# Application Outputs and Uploads
outputs/*
!outputs/.gitkeep
static/outputs/*
!static/outputs/.gitkeep
static/uploads/*
!static/uploads/.gitkeep
temp_speech.mp3

# macOS
.DS_Store
